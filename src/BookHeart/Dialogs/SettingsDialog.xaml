<Window x:Class="BookHeart.Dialogs.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:BookHeart.Controls"
        Width="660" Height="860" MinWidth="420" MinHeight="400">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,2,0,0" Padding="24,16,24,4">
      <WrapPanel>
        <Button x:Name="OkBtn" Style="{StaticResource PrimaryButton}" Content="Save" IsDefault="True" />
        <Button x:Name="CancelBtn" Content="Cancel" IsCancel="True" />
      </WrapPanel>
    </Border>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
      <StackPanel Margin="24">
        <TextBlock Style="{StaticResource H1}" FontSize="28" Margin="0,0,0,8" Text="Settings" />

        <TextBlock Style="{StaticResource H2}" Margin="0,8,0,8" Text="Default listening settings" />
        <TextBlock Style="{StaticResource MutedPara}" FontSize="17">Every book uses these unless you give it its own in Book settings.</TextBlock>
        <c:AudioSettingsPanel x:Name="Audio" />
        <Button x:Name="ApplyAllBtn" Content="Use these for every book…" HorizontalAlignment="Left" Margin="0,16,0,0" FontWeight="Normal"
                AutomationProperties.HelpText="Clears the speed, volume and skip amount you set for individual books." />

        <TextBlock Style="{StaticResource H2}" Margin="0,24,0,8" Text="Appearance" />
        <Label Style="{StaticResource FieldLabel}" Target="{Binding ElementName=ThemeBox}" Content="Colours" />
        <ComboBox x:Name="ThemeBox" AutomationProperties.Name="Colours" HorizontalAlignment="Left" MinWidth="280" />
        <TextBlock Style="{StaticResource MutedPara}" FontSize="16" Margin="0,6,0,0">When Windows high contrast is on, its colours are always used.</TextBlock>

        <TextBlock Style="{StaticResource H2}" Margin="0,24,0,8" Text="Updates" />
        <CheckBox x:Name="CheckUpdatesBox" VerticalContentAlignment="Center" Margin="0,0,0,10">
          <TextBlock TextWrapping="Wrap" Text="Check for updates when BookHeart starts and once a day" />
        </CheckBox>
        <CheckBox x:Name="TestVersionsBox" VerticalContentAlignment="Center">
          <TextBlock TextWrapping="Wrap" Text="Include test versions (for people helping to test BookHeart)" />
        </CheckBox>
        <TextBlock Style="{StaticResource MutedPara}" FontSize="16" Margin="0,6,0,0">Checking for updates only asks GitHub for the list of BookHeart versions. Nothing about you or your books is sent. You can always check by hand from Help → Check for updates.</TextBlock>

        <TextBlock Style="{StaticResource H2}" Margin="0,24,0,8" Text="Starting up" />
        <CheckBox x:Name="OpenLastBox" VerticalContentAlignment="Center">
          <TextBlock TextWrapping="Wrap" Text="Open the book I was listening to when the app starts" />
        </CheckBox>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
