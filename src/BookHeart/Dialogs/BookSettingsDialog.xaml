<Window x:Class="BookHeart.Dialogs.BookSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:BookHeart.Controls"
        Width="640" Height="820" MinWidth="420" MinHeight="400">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,2,0,0" Padding="24,16,24,4">
      <Button x:Name="CloseBtn" Style="{StaticResource PrimaryButton}" Content="Close" IsCancel="True" HorizontalAlignment="Left" />
    </Border>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
      <StackPanel Margin="24">
        <TextBlock x:Name="Heading" Style="{StaticResource H1}" FontSize="28" Margin="0,0,0,8" />
        <TextBlock Style="{StaticResource MutedPara}" FontSize="17">Changes apply straight away. Settings you change here are kept for this book only; the rest follow your defaults in Settings.</TextBlock>

        <Label Style="{StaticResource FieldLabel}" Target="{Binding ElementName=TitleBox}" Content="Title" />
        <TextBox x:Name="TitleBox" AutomationProperties.Name="Title" Margin="0,0,0,24" />

        <TextBlock Style="{StaticResource H2}" Margin="0,0,0,12" Text="Listening" />
        <c:AudioSettingsPanel x:Name="Audio" />

        <TextBlock Style="{StaticResource H2}" Margin="0,24,0,12" Text="Files" />
        <TextBlock x:Name="FilesInfo" Style="{StaticResource Para}" />
        <WrapPanel>
          <Button x:Name="OrderBtn" Content="Change file order…" />
          <Button x:Name="ExplorerBtn" Content="Show in File Explorer" />
        </WrapPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
