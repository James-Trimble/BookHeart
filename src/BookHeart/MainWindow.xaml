<Window x:Class="BookHeart.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:BookHeart.Controls"
        Title="BookHeart" Width="980" Height="900" MinWidth="460" MinHeight="420"
        WindowStartupLocation="CenterScreen" AllowDrop="True" Icon="Assets/app.ico"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Ink}"
        FontFamily="{StaticResource BodyFont}" FontSize="20">
  <DockPanel>
    <Menu x:Name="MainMenu" DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem x:Name="MenuAddBooks" Header="_Add books…" InputGestureText="Ctrl+O" />
        <MenuItem x:Name="MenuAddFolder" Header="Add a _folder of books…" InputGestureText="Ctrl+Shift+O" />
        <Separator />
        <MenuItem x:Name="MenuSettings" Header="_Settings…" InputGestureText="Ctrl+Comma" />
        <Separator />
        <MenuItem x:Name="MenuExit" Header="E_xit" InputGestureText="Alt+F4" />
      </MenuItem>
      <MenuItem x:Name="PlaybackMenu" Header="P_layback">
        <MenuItem x:Name="MenuPlay" Header="_Play / Pause" InputGestureText="Alt+P" />
        <MenuItem x:Name="MenuBack" Header="Skip _back" InputGestureText="Alt+Comma" />
        <MenuItem x:Name="MenuForward" Header="Skip _forward" InputGestureText="Alt+Period" />
        <MenuItem x:Name="MenuPrevChapter" Header="Pre_vious chapter" InputGestureText="Alt+Left" />
        <MenuItem x:Name="MenuNextChapter" Header="_Next chapter" InputGestureText="Alt+Right" />
        <Separator />
        <MenuItem x:Name="MenuFaster" Header="F_aster" InputGestureText="Ctrl+]" />
        <MenuItem x:Name="MenuSlower" Header="_Slower" InputGestureText="Ctrl+[" />
        <MenuItem x:Name="MenuVolUp" Header="Volume _up" InputGestureText="Alt+Up" />
        <MenuItem x:Name="MenuVolDown" Header="Volume _down" InputGestureText="Alt+Down" />
        <Separator />
        <MenuItem x:Name="MenuBookmark" Header="Add boo_kmark" InputGestureText="Alt+B" />
        <MenuItem x:Name="MenuBookmarkNote" Header="Add bookmark with _note…" InputGestureText="Ctrl+B" />
        <MenuItem x:Name="MenuWhere" Header="_Where am I?" InputGestureText="Alt+I" />
        <Separator />
        <MenuItem x:Name="MenuBookSettings" Header="Book _settings…" InputGestureText="Ctrl+E" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem x:Name="MenuLibrary" Header="_Library" InputGestureText="Ctrl+1" />
        <MenuItem x:Name="MenuNowPlaying" Header="_Now playing" InputGestureText="Ctrl+2" />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem x:Name="MenuManual" Header="User _manual" />
        <MenuItem x:Name="MenuShortcuts" Header="_Keyboard shortcuts" InputGestureText="F1" />
        <MenuItem x:Name="MenuDataFolder" Header="Open _data folder" />
        <Separator />
        <MenuItem x:Name="MenuAbout" Header="_About" />
      </MenuItem>
    </Menu>

    <!-- What the app last said, also shown on screen. -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,2,0,0" Padding="20,8">
      <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="17" Text="Ready." />
    </Border>

    <Grid>
      <!-- ============================== Library ============================== -->
      <DockPanel x:Name="LibraryView" Margin="24,12,24,16">
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Style="{StaticResource H1}" Text="Library" />

          <Border x:Name="ContinueCard" Style="{StaticResource Card}" Margin="0,4,0,8" Visibility="Collapsed">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,16,12">
                <TextBlock x:Name="ContLabel" Foreground="{DynamicResource Muted}" FontSize="17" Text="Continue listening" />
                <TextBlock x:Name="ContTitle" FontSize="26" FontWeight="Bold" TextWrapping="Wrap" />
                <TextBlock x:Name="ContMeta" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />
                <ProgressBar x:Name="ContProgress" Maximum="100" Margin="0,10,0,0" AutomationProperties.Name="Progress through the book" />
              </StackPanel>
              <Button x:Name="ContBtn" Grid.Column="1" Style="{StaticResource PrimaryButton}" FontSize="22" MinHeight="60" MinWidth="170"
                      VerticalAlignment="Center" AutomationProperties.AcceleratorKey="Alt+R" />
            </Grid>
          </Border>

          <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <WrapPanel>
              <Button x:Name="AddBooksBtn" Style="{StaticResource PrimaryButton}" Content="Add books…" AutomationProperties.AcceleratorKey="Control+O" />
              <Button x:Name="AddFolderBtn" Content="Add a folder…" AutomationProperties.AcceleratorKey="Control+Shift+O" />
            </WrapPanel>
          </Grid>

          <Grid Margin="0,4,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0">
              <Label Style="{StaticResource FieldLabel}" Target="{Binding ElementName=SearchBox}" Content="Search your library" />
              <TextBox x:Name="SearchBox" AutomationProperties.Name="Search your library" />
            </StackPanel>
            <StackPanel Grid.Column="1" MinWidth="230">
              <Label Style="{StaticResource FieldLabel}" Target="{Binding ElementName=SortBox}" Content="Sort by" />
              <ComboBox x:Name="SortBox" AutomationProperties.Name="Sort by" />
            </StackPanel>
          </Grid>

          <TextBlock x:Name="LibraryCount" Style="{StaticResource MutedPara}" FontSize="17" Margin="0,4,0,6" />
        </StackPanel>

        <WrapPanel x:Name="BookButtons" DockPanel.Dock="Bottom" Margin="0,4,0,0">
          <Button x:Name="BookPlayBtn" Style="{StaticResource PrimaryButton}" Content="Play" />
          <Button x:Name="BookSettingsBtn2" Content="Book settings…" />
          <Button x:Name="BookRemoveBtn" Style="{StaticResource DangerButton}" Content="Remove from library" />
        </WrapPanel>

        <Grid>
          <ListBox x:Name="BookList" ItemContainerStyle="{StaticResource RowItem}" ItemTemplate="{StaticResource RowTemplate}" MaxHeight="Infinity"
                   AutomationProperties.Name="Books. Press Enter to play, Delete to remove, or the Applications key for more.">
            <ListBox.ContextMenu>
              <ContextMenu x:Name="BookMenu">
                <MenuItem x:Name="CtxPlay" Header="_Play" />
                <MenuItem x:Name="CtxSettings" Header="Book _settings…" />
                <MenuItem x:Name="CtxFinished" Header="Mark as _finished" />
                <MenuItem x:Name="CtxRestart" Header="Mark as _not started" />
                <MenuItem x:Name="CtxExplorer" Header="Show in File _Explorer" />
                <Separator />
                <MenuItem x:Name="CtxRemove" Header="_Remove from library" />
              </ContextMenu>
            </ListBox.ContextMenu>
          </ListBox>
          <Border x:Name="EmptyLibrary" Style="{StaticResource Card}" VerticalAlignment="Top" Margin="0" Visibility="Collapsed">
            <StackPanel Margin="0,0,12,12">
              <TextBlock FontSize="24" FontWeight="Bold" TextWrapping="Wrap" Text="Your library is empty" />
              <TextBlock Style="{StaticResource Para}" Margin="0,8,0,0">Choose Add books to pick audiobook files, or Add a folder to bring in every book in a folder at once. You can also drag files or folders onto this window.</TextBlock>
              <TextBlock Style="{StaticResource MutedPara}" Margin="0">A book can be one file, like an .m4b, or a folder of files that play in order. Your files stay where they are.</TextBlock>
            </StackPanel>
          </Border>
        </Grid>
      </DockPanel>

      <!-- ============================== Now playing ============================== -->
      <DockPanel x:Name="PlayerView" Margin="24,12,24,16" Visibility="Collapsed">
        <Grid DockPanel.Dock="Top">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button x:Name="ToLibraryBtn" Margin="0,0,16,0" VerticalAlignment="Center" AutomationProperties.Name="Back to library" AutomationProperties.AcceleratorKey="Escape">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource IconText}" FontSize="18" Text="&#xE72B;" Margin="0,0,8,0" VerticalAlignment="Center" />
              <TextBlock Text="Library" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,0,12">
            <TextBlock x:Name="BookTitle" FontSize="28" FontWeight="Bold" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level1" />
            <TextBlock x:Name="ChapterNow" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Visibility="Collapsed" />
          </StackPanel>
          <Button x:Name="BookSettingsBtn" Grid.Column="2" Content="Book settings…" VerticalAlignment="Center" Margin="16,0,0,12"
                  AutomationProperties.AcceleratorKey="Control+E" />
        </Grid>

        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,8,0,16">
          <StackPanel>
            <TextBlock HorizontalAlignment="Center">
              <Run x:Name="ClockNow" FontSize="60" FontWeight="Bold" Text="0:00" />
              <Run Foreground="{DynamicResource Muted}" Text=" of " /><Run x:Name="ClockTotal" Foreground="{DynamicResource Muted}" Text="0:00" />
            </TextBlock>
            <TextBlock x:Name="BookLeft" HorizontalAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="17" Margin="0,0,0,8" />

            <Label x:Name="SeekLabel" Style="{StaticResource FieldLabel}" Target="{Binding ElementName=Seek}" Content="Position in book" />
            <c:SpokenSlider x:Name="Seek" Minimum="0" Maximum="0" SmallChange="5" LargeChange="60" Margin="0,0,12,12"
                            AutomationProperties.LabeledBy="{Binding ElementName=SeekLabel}" />

            <UniformGrid Rows="1" Margin="0,4,0,0">
              <Button x:Name="PrevChBtn" AutomationProperties.Name="Previous chapter" AutomationProperties.AcceleratorKey="Alt+Left" Padding="8">
                <StackPanel><TextBlock Style="{StaticResource IconText}" Text="&#xE892;" /><TextBlock x:Name="PrevChLabel" Text="Chapter" HorizontalAlignment="Center" FontSize="16" /></StackPanel>
              </Button>
              <Button x:Name="BackBtn" AutomationProperties.AcceleratorKey="Alt+Comma" Padding="8">
                <StackPanel><TextBlock Style="{StaticResource IconText}" Text="&#xE72B;" /><TextBlock x:Name="BackLabel" HorizontalAlignment="Center" FontSize="16" /></StackPanel>
              </Button>
              <Button x:Name="PlayBtn" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="Play" AutomationProperties.AcceleratorKey="Alt+P" MinHeight="76" Padding="8">
                <StackPanel>
                  <TextBlock x:Name="PlayIcon" Style="{StaticResource IconText}" FontSize="30" Text="&#xE768;" />
                  <TextBlock x:Name="PlayLabel" Text="Play" HorizontalAlignment="Center" FontSize="18" />
                </StackPanel>
              </Button>
              <Button x:Name="FwdBtn" AutomationProperties.AcceleratorKey="Alt+Period" Padding="8">
                <StackPanel><TextBlock Style="{StaticResource IconText}" Text="&#xE72A;" /><TextBlock x:Name="FwdLabel" HorizontalAlignment="Center" FontSize="16" /></StackPanel>
              </Button>
              <Button x:Name="NextChBtn" AutomationProperties.Name="Next chapter" AutomationProperties.AcceleratorKey="Alt+Right" Padding="8">
                <StackPanel><TextBlock Style="{StaticResource IconText}" Text="&#xE893;" /><TextBlock Text="Chapter" HorizontalAlignment="Center" FontSize="16" /></StackPanel>
              </Button>
            </UniformGrid>
            <WrapPanel HorizontalAlignment="Center">
              <Button x:Name="WhereBtn" Content="Where am I?" AutomationProperties.AcceleratorKey="Alt+I" />
              <Button x:Name="AddBmBtn" Content="Add bookmark" AutomationProperties.AcceleratorKey="Alt+B" />
              <TextBlock x:Name="SpeedBadge" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="17" Margin="4,0,12,12" />
            </WrapPanel>
          </StackPanel>
        </Border>

        <TabControl x:Name="Tabs">
          <TabItem x:Name="ChaptersTab" Header="Chapters">
            <DockPanel>
              <TextBlock x:Name="NoChapters" DockPanel.Dock="Top" Style="{StaticResource MutedPara}" Visibility="Collapsed"
                         Text="This book has no chapter markers. Use the position slider, skip buttons or bookmarks to move around." />
              <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Button x:Name="ChGoBtn" Content="Play selected chapter" />
                <Button x:Name="ChangeOrderBtn" Content="Change file order…" Visibility="Collapsed" />
              </WrapPanel>
              <ListBox x:Name="ChList" ItemContainerStyle="{StaticResource RowItem}" ItemTemplate="{StaticResource RowTemplate}" MaxHeight="Infinity" Margin="0"
                       AutomationProperties.Name="Chapters. Press Enter to play the selected chapter." />
            </DockPanel>
          </TabItem>
          <TabItem x:Name="BookmarksTab" Header="Bookmarks">
            <DockPanel>
              <TextBlock x:Name="BmEmpty" DockPanel.Dock="Top" Style="{StaticResource MutedPara}"
                         Text="No bookmarks yet. Choose Add bookmark, or press Alt+B, to mark the spot you're listening to." />
              <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Button x:Name="BmAddNoteBtn" Content="Add bookmark with note…" AutomationProperties.AcceleratorKey="Control+B" />
                <Button x:Name="BmGoBtn" Content="Go to bookmark" />
                <Button x:Name="BmEditBtn" Content="Edit note…" />
                <Button x:Name="BmDeleteBtn" Style="{StaticResource DangerButton}" Content="Delete" AutomationProperties.Name="Delete bookmark" />
              </WrapPanel>
              <ListBox x:Name="BmList" ItemContainerStyle="{StaticResource RowItem}" ItemTemplate="{StaticResource RowTemplate}" MaxHeight="Infinity" Margin="0"
                       AutomationProperties.Name="Bookmarks. Press Enter to go there, Delete to remove." />
            </DockPanel>
          </TabItem>
        </TabControl>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
