<Window x:Class="AudiobookPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:AudiobookPlayer.Controls"
        Title="Audiobook Player" Width="900" Height="1000" MinWidth="420" MinHeight="400"
        WindowStartupLocation="CenterScreen" AllowDrop="True"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Ink}"
        FontFamily="{StaticResource BodyFont}" FontSize="20">
  <DockPanel>
    <!-- What the app last said, also shown on screen. -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,2,0,0" Padding="20,10">
      <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="17" Text="Ready." />
    </Border>

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel MaxWidth="760" Margin="24,16,24,48">
        <TextBlock Style="{StaticResource H1}" Text="Audiobook Player" />
        <TextBlock Style="{StaticResource Para}">Your place and bookmarks are remembered for every book. A book can be one file, or a set of files that play in order.</TextBlock>

        <!-- Continue listening -->
        <StackPanel x:Name="ContinueSection" Visibility="Collapsed">
          <TextBlock Style="{StaticResource H2}" Margin="0,20,0,0" Text="Continue listening" />
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock x:Name="ContTitle" FontSize="26" FontWeight="Bold" TextWrapping="Wrap" />
              <TextBlock x:Name="ContMeta" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
              <ProgressBar x:Name="ContProgress" Maximum="100" Margin="0,14,12,0" AutomationProperties.Name="Progress through the book" />
              <TextBlock x:Name="ContHint" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0" />
              <Button x:Name="ContBtn" Style="{StaticResource PrimaryButton}" FontSize="24" MinHeight="64" Margin="0,16,12,12"
                      HorizontalAlignment="Stretch" AutomationProperties.AcceleratorKey="Alt+R" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Open -->
        <WrapPanel Margin="0,24,0,0">
          <Button x:Name="OpenBtn" Style="{StaticResource PrimaryButton}" Content="Open audiobook files…" AutomationProperties.AcceleratorKey="Alt+O"
                  AutomationProperties.HelpText="Pick one file, or several files at once to play them in order." />
          <Button x:Name="FolderBtn" Content="Open a folder…" AutomationProperties.HelpText="Plays every audio file in a folder and its subfolders, in order." />
        </WrapPanel>
        <TextBlock Style="{StaticResource MutedPara}" FontSize="17">Pick one file, or several at once to play them in order. You can also drag files or a folder onto this window.</TextBlock>

        <!-- Check the order of a multi-file book -->
        <Border x:Name="OrderSection" Visibility="Collapsed" Style="{StaticResource Card}" BorderBrush="{DynamicResource Primary}" Margin="0,24,0,0">
          <StackPanel>
            <TextBlock x:Name="OrderHeading" Style="{StaticResource H2}" Margin="0,0,0,12" Text="Check the order" />
            <TextBlock x:Name="OrderIntro" Style="{StaticResource Para}" />
            <ListBox x:Name="OrderList" ItemContainerStyle="{StaticResource RowItem}" ItemTemplate="{StaticResource RowTemplate}"
                     AutomationProperties.Name="Play order. Control plus Up or Down arrow moves the selected file." />
            <WrapPanel>
              <Button x:Name="OrderUpBtn" Content="Move up" AutomationProperties.AcceleratorKey="Control+Up" />
              <Button x:Name="OrderDownBtn" Content="Move down" AutomationProperties.AcceleratorKey="Control+Down" />
              <Button x:Name="OrderToBtn" Content="Move to position…" />
            </WrapPanel>
            <StackPanel x:Name="MoveToPanel" Visibility="Collapsed" Orientation="Horizontal" Margin="0,0,0,12">
              <Label x:Name="MoveToLabel" Style="{StaticResource FieldLabel}" Target="{Binding ElementName=MoveToBox}" VerticalAlignment="Center" Margin="0,0,12,0" />
              <TextBox x:Name="MoveToBox" Width="110" InputScope="Number" />
              <Button x:Name="MoveToGo" Style="{StaticResource PrimaryButton}" Content="Move" Margin="12,0,12,0" />
              <Button x:Name="MoveToCancel" Content="Cancel" Margin="0" />
            </StackPanel>
            <WrapPanel>
              <Button x:Name="OrderGo" Style="{StaticResource PrimaryButton}" Content="Start listening" />
              <Button x:Name="OrderReset" Content="Sort by name again" />
              <Button x:Name="OrderCancel" Content="Cancel" />
            </WrapPanel>
          </StackPanel>
        </Border>

        <!-- Recent books -->
        <StackPanel x:Name="RecentSection" Visibility="Collapsed">
          <TextBlock x:Name="RecentHeading" Style="{StaticResource H2}" Text="Recent books" />
          <ListBox x:Name="RecentList" ItemContainerStyle="{StaticResource RowItem}" ItemTemplate="{StaticResource RowTemplate}"
                   AutomationProperties.Name="Recent books. Press Enter to open, Delete to remove." />
          <WrapPanel>
            <Button x:Name="RecentOpenBtn" Content="Open selected book" />
            <Button x:Name="RecentRemoveBtn" Style="{StaticResource DangerButton}" Content="Remove from list" />
          </WrapPanel>
        </StackPanel>

        <!-- Player -->
        <StackPanel x:Name="PlayerSection" Visibility="Collapsed">
          <Border Style="{StaticResource Card}" Margin="0,24,0,0">
            <StackPanel>
              <TextBlock Style="{StaticResource H2}" Margin="0" Text="Now playing" FontSize="17" Foreground="{DynamicResource Muted}" />
              <TextBlock x:Name="BookTitle" FontSize="28" FontWeight="Bold" TextWrapping="Wrap" />
              <TextBlock x:Name="ChapterNow" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Visibility="Collapsed" />
              <TextBlock x:Name="QualityNow" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="17" Visibility="Collapsed" />
              <TextBlock Margin="0,14,0,0">
                <Run x:Name="ClockNow" FontSize="56" FontWeight="Bold" Text="0:00" />
                <Run Foreground="{DynamicResource Muted}" Text=" of " /><Run x:Name="ClockTotal" Foreground="{DynamicResource Muted}" Text="0:00" />
              </TextBlock>

              <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" /><ColumnDefinition Width="1.4*" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="BackBtn" Grid.Column="0" Content="Back 30 seconds" AutomationProperties.AcceleratorKey="Alt+Comma" />
                <Button x:Name="PlayBtn" Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Play" FontSize="26" MinHeight="72" AutomationProperties.AcceleratorKey="Alt+P" />
                <Button x:Name="FwdBtn" Grid.Column="2" Content="Forward 30 seconds" AutomationProperties.AcceleratorKey="Alt+Period" />
              </Grid>
              <WrapPanel>
                <Button x:Name="WhereBtn" Content="Where am I?" AutomationProperties.AcceleratorKey="Alt+I" />
                <Button x:Name="PrevChBtn" Content="Previous chapter" Visibility="Collapsed" AutomationProperties.AcceleratorKey="Alt+Left" />
                <Button x:Name="NextChBtn" Content="Next chapter" Visibility="Collapsed" AutomationProperties.AcceleratorKey="Alt+Right" />
              </WrapPanel>

              <Label x:Name="SeekLabel" Style="{StaticResource FieldLabel}" Target="{Binding ElementName=Seek}" Content="Position in book" Margin="0,8,0,0" />
              <c:SpokenSlider x:Name="Seek" Minimum="0" Maximum="0" SmallChange="5" LargeChange="60" Margin="0,0,12,12"
                              AutomationProperties.LabeledBy="{Binding ElementName=SeekLabel}" />

              <Label x:Name="VolumeLabel" Style="{StaticResource FieldLabel}" Target="{Binding ElementName=Volume}" Content="Volume" />
              <c:SpokenSlider x:Name="Volume" Minimum="0" Maximum="300" SmallChange="5" LargeChange="10" Margin="0,0,12,4"
                              AutomationProperties.LabeledBy="{Binding ElementName=VolumeLabel}"
                              AutomationProperties.HelpText="Goes up to 300 percent for quiet recordings." />
              <TextBlock Style="{StaticResource MutedPara}" FontSize="17">Goes up to 300 percent for quiet recordings. Above 100 percent, loud parts are gently limited.</TextBlock>
              <WrapPanel>
                <Button x:Name="VolDownBtn" Content="Volume down" AutomationProperties.AcceleratorKey="Alt+Down" />
                <Button x:Name="VolUpBtn" Content="Volume up" AutomationProperties.AcceleratorKey="Alt+Up" />
              </WrapPanel>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,12">
                  <Label Style="{StaticResource FieldLabel}" Target="{Binding ElementName=SpeedBox}" Content="Speed" />
                  <ComboBox x:Name="SpeedBox" AutomationProperties.Name="Speed" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,12">
                  <Label Style="{StaticResource FieldLabel}" Target="{Binding ElementName=SkipBox}" Content="Skip amount" />
                  <ComboBox x:Name="SkipBox" AutomationProperties.Name="Skip amount" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <TextBlock Style="{StaticResource H2}" Text="Bookmarks" />
          <Label Style="{StaticResource FieldLabel}" Target="{Binding ElementName=BmNote}" Content="Bookmark note (optional)" />
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="BmNote" Grid.Column="0" AutomationProperties.Name="Bookmark note (optional)" />
            <Button x:Name="AddBmBtn" Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Add bookmark here" Margin="12,0,0,0"
                    AutomationProperties.AcceleratorKey="Alt+B" />
          </Grid>
          <TextBlock x:Name="BmEmpty" Style="{StaticResource MutedPara}" Text="No bookmarks yet for this book." />
          <ListBox x:Name="BmList" ItemContainerStyle="{StaticResource RowItem}" ItemTemplate="{StaticResource RowTemplate}"
                   AutomationProperties.Name="Bookmarks. Press Enter to go there, Delete to remove." />
          <WrapPanel x:Name="BmButtons">
            <Button x:Name="BmGoBtn" Content="Go to bookmark" />
            <Button x:Name="BmDeleteBtn" Style="{StaticResource DangerButton}" Content="Delete bookmark" />
          </WrapPanel>

          <StackPanel x:Name="ChSection" Visibility="Collapsed">
            <TextBlock Style="{StaticResource H2}" Text="Chapters" />
            <ListBox x:Name="ChList" ItemContainerStyle="{StaticResource RowItem}" ItemTemplate="{StaticResource RowTemplate}"
                     AutomationProperties.Name="Chapters. Press Enter to play the selected chapter." />
            <WrapPanel>
              <Button x:Name="ChGoBtn" Content="Play selected chapter" />
              <Button x:Name="ChangeOrderBtn" Content="Change order of files" Visibility="Collapsed" />
            </WrapPanel>
          </StackPanel>
        </StackPanel>

        <TextBlock Style="{StaticResource H2}" Text="Keyboard shortcuts" />
        <TextBlock Style="{StaticResource Para}">These work anywhere in the window. Every control can also be reached with Tab.</TextBlock>
        <Grid x:Name="KeysGrid">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
        </Grid>
        <TextBlock Style="{StaticResource MutedPara}" Margin="0,12,0,0">Keyboard and headphone media keys also play, pause and skip, even when this window isn't in front.</TextBlock>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
