<UserControl x:Class="AudiobookPlayer.Controls.AudioSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AudiobookPlayer.Controls">
  <StackPanel>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Label x:Name="SpeedLabel" Style="{StaticResource FieldLabel}" Target="{Binding ElementName=Speed}" Content="Speed" />
      <TextBlock x:Name="SpeedValue" Grid.Column="1" FontWeight="Bold" />
    </Grid>
    <c:SpokenSlider x:Name="Speed" Minimum="0.5" Maximum="3" SmallChange="0.05" LargeChange="0.25" TickFrequency="0.05" IsSnapToTickEnabled="True"
                    Margin="0,0,0,4" AutomationProperties.LabeledBy="{Binding ElementName=SpeedLabel}"
                    AutomationProperties.HelpText="Left and Right arrows change it in small steps, Page Up and Page Down in bigger ones." />
    <Button x:Name="SpeedReset" HorizontalAlignment="Left" FontWeight="Normal" Visibility="Collapsed" Margin="0,0,0,16" />

    <Grid Margin="0,8,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Label x:Name="VolumeLabel" Style="{StaticResource FieldLabel}" Target="{Binding ElementName=Volume}" Content="Volume" />
      <TextBlock x:Name="VolumeValue" Grid.Column="1" FontWeight="Bold" />
    </Grid>
    <c:SpokenSlider x:Name="Volume" Minimum="0" Maximum="300" SmallChange="5" LargeChange="25" TickFrequency="5" IsSnapToTickEnabled="True"
                    Margin="0,0,0,4" AutomationProperties.LabeledBy="{Binding ElementName=VolumeLabel}"
                    AutomationProperties.HelpText="Goes up to 300 percent for quiet recordings. Above 100 percent, loud parts are gently limited." />
    <TextBlock Style="{StaticResource MutedPara}" FontSize="16" Text="Goes up to 300 percent for quiet recordings." Margin="0,0,0,4" />
    <Button x:Name="VolumeReset" HorizontalAlignment="Left" FontWeight="Normal" Visibility="Collapsed" Margin="0,0,0,16" />

    <Label Style="{StaticResource FieldLabel}" Target="{Binding ElementName=Skip}" Content="Skip amount" Margin="0,8,0,0" />
    <ComboBox x:Name="Skip" AutomationProperties.Name="Skip amount" HorizontalAlignment="Left" MinWidth="240" Margin="0,0,0,8" />
    <Button x:Name="SkipReset" HorizontalAlignment="Left" FontWeight="Normal" Visibility="Collapsed" />
  </StackPanel>
</UserControl>
