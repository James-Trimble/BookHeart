<Window x:Class="AudiobookPlayer.Dialogs.FileOrderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="760" Height="760" MinWidth="460" MinHeight="400">
  <DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock x:Name="Intro" Style="{StaticResource Para}" />
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom">
      <WrapPanel>
        <Button x:Name="UpBtn" Content="Move up" AutomationProperties.AcceleratorKey="Control+Up" />
        <Button x:Name="DownBtn" Content="Move down" AutomationProperties.AcceleratorKey="Control+Down" />
        <Button x:Name="ToBtn" Content="Move to position…" />
        <Button x:Name="ResetBtn" Content="Sort by name again" />
      </WrapPanel>
      <WrapPanel Margin="0,8,0,0">
        <Button x:Name="OkBtn" Style="{StaticResource PrimaryButton}" Content="Save order" IsDefault="True" />
        <Button x:Name="CancelBtn" Content="Cancel" IsCancel="True" />
      </WrapPanel>
    </StackPanel>
    <ListBox x:Name="List" ItemContainerStyle="{StaticResource RowItem}" ItemTemplate="{StaticResource RowTemplate}" MaxHeight="Infinity"
             AutomationProperties.Name="Play order. Control plus Up or Down arrow moves the selected file." />
  </DockPanel>
</Window>
