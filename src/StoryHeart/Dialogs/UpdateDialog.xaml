<Window x:Class="StoryHeart.Dialogs.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="700" Height="680" MinWidth="440" MinHeight="380">
  <DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock x:Name="Heading" Style="{StaticResource H1}" FontSize="28" Margin="0,0,0,8" />
      <TextBlock x:Name="Intro" Style="{StaticResource Para}" />
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom">
      <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,8,0,12">
        <TextBlock x:Name="ProgressText" Style="{StaticResource Para}" Margin="0,0,0,6" />
        <ProgressBar x:Name="Progress" Maximum="100" AutomationProperties.Name="Download progress" />
      </StackPanel>
      <WrapPanel x:Name="Choices">
        <Button x:Name="InstallBtn" Style="{StaticResource PrimaryButton}" Content="Install now" IsDefault="True" />
        <Button x:Name="LaterBtn" Content="Remind me later" />
        <Button x:Name="SkipBtn" Content="Skip this version" />
      </WrapPanel>
      <Button x:Name="CancelBtn" Content="Cancel download" Visibility="Collapsed" HorizontalAlignment="Left" />
    </StackPanel>

    <DockPanel>
      <Label DockPanel.Dock="Top" Style="{StaticResource FieldLabel}" Target="{Binding ElementName=Notes}" Content="What's new" />
      <TextBox x:Name="Notes" IsReadOnly="True" IsReadOnlyCaretVisible="True" TextWrapping="Wrap" AcceptsReturn="True"
               VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" AutomationProperties.Name="What's new" Margin="0,0,0,16" />
    </DockPanel>
  </DockPanel>
</Window>
